generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProductStatus {
  active
  inactive
}

enum IncomingOrderStatus {
  pendiente
  recibida
  en_preparacion
  listo
  entregada
}

enum ProductCategory {
  suculentas
  plantas_de_interior
  aromaticas
  frutales
  cactus
  colecciones_raras
  macetas_y_kits
}

enum SellerStatus {
  active
  inactive
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Seller {
  id          Int          @id @default(autoincrement())
  clerkUserId String       @unique @map("clerk_user_id")
  name        String
  email       String
  city        String?      
  address     String?
  iconUrl     String?      @map("icon_url")
  status      SellerStatus @default(active)
  products    Product[]
  incomingOrders IncomingOrder[]
  payoutNotifications PayoutNotification[]

  @@map("sellers")
  
}

model Product {
  id                 Int                 @id @default(autoincrement())
  sellerId           Int                 @map("seller_id")
  seller             Seller              @relation(fields: [sellerId], references: [id])
  name               String
  description        String?
  category           ProductCategory
  price              Float
  stockAvailable     Int                 @default(0) @map("stock_available")
  stockReserved      Int                 @default(0) @map("stock_reserved")
  imageUrl           String?             @map("image_url")
  status             ProductStatus       @default(active)
  createdAt          DateTime            @default(now()) @map("created_at")
  incomingOrderItems IncomingOrderItem[]

  @@map("products")
}

model IncomingOrder {
  id           Int                 @id @default(autoincrement())
  sellerId     Int                 @map("seller_id")
  seller       Seller              @relation(fields: [sellerId], references: [id])
  buyerOrderId String              @map("buyer_order_id")
  buyerId      String              @map("buyer_id")
  total        Float
  status       IncomingOrderStatus @default(pendiente)
  createdAt    DateTime            @default(now()) @map("created_at")
  items        IncomingOrderItem[]

  @@map("incoming_orders")
}

model IncomingOrderItem {
  id                  Int           @id @default(autoincrement())
  incomingOrderId     Int           @map("incoming_order_id")
  incomingOrder       IncomingOrder @relation(fields: [incomingOrderId], references: [id])
  productId           Int           @map("product_id")
  product             Product       @relation(fields: [productId], references: [id])
  productNameSnapshot String        @map("product_name_snapshot")
  unitPriceSnapshot   Float         @map("unit_price_snapshot")
  quantity            Int

  @@map("incoming_order_items")
}

model PayoutNotification {
  id         Int      @id @default(autoincrement())
  sellerId   Int      @map("seller_id")
  seller     Seller   @relation(fields: [sellerId], references: [id])
  paymentId  String   @map("payment_id")
  amount     Float
  currency   String
  read       Boolean  @default(false)
  createdAt  DateTime @map("created_at")

  @@map("payout_notifications")
}